@{
    ViewBag.Title = "Editar Caja";
}

<h2>Editar Caja</h2>

<div id="alertaError" class="alert alert-danger d-none"></div>

<div class="mb-3">
    <label class="form-label">Nombre</label>
    <input type="text" class="form-control" id="Nombre" />
</div>
<div class="mb-3">
    <label class="form-label">Descripción</label>
    <input type="text" class="form-control" id="Descripcion" />
</div>
<div class="mb-3">
    <label class="form-label">Teléfono SINPE</label>
    <input type="text" class="form-control" id="TelefonoSINPE" />
</div>
<div class="mb-3">
    <label class="form-label">Estado</label>
    <select class="form-control" id="Estado">
        <option value="true">Activo</option>
        <option value="false">Inactivo</option>
    </select>
</div>
<div class="mb-3">
    <a id="btnCancelar" href="#" class="btn btn-secondary">Cancelar</a>
    <button class="btn btn-primary" id="btnGuardar">Guardar</button>
</div>

@section Scripts {
    <script>
        const API = "https://localhost:7004";
        const idCaja = parseInt(window.location.pathname.split("/").pop());
        let idComercio = null;

        // Cargar datos actuales
        $.ajax({
            url: `${API}/api/Cajas/detalle/${idCaja}`,
            method: "GET",
            success: function(c) {
                idComercio = c.idComercio;
                $("#Nombre").val(c.nombre);
                $("#Descripcion").val(c.descripcion);
                $("#TelefonoSINPE").val(c.telefonoSINPE);
                $("#Estado").val(c.estado.toString());
                $("#btnCancelar").attr("href", `/Cajas/Index/${idComercio}`);
            }
        });

        $("#btnGuardar").click(function() {
            const caja = {
                idCaja: idCaja,
                idComercio: idComercio,
                nombre: $("#Nombre").val(),
                descripcion: $("#Descripcion").val(),
                telefonoSINPE: $("#TelefonoSINPE").val(),
                estado: $("#Estado").val() === "true"
            };

            $.ajax({
                url: `${API}/api/Cajas`,
                method: "PUT",
                contentType: "application/json",
                data: JSON.stringify(caja),
                success: function() {
                    window.location.href = `/Cajas/Index/${idComercio}`;
                },
                error: function(xhr) {
                    const msg = xhr.responseJSON?.mensaje ?? "Error al actualizar la caja.";
                    $("#alertaError").text(msg).removeClass("d-none");
                }
            });
        });
    </script>
}