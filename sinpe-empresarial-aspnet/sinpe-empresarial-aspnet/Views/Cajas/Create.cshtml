@{
    ViewBag.Title = "Registrar Caja";
}

<h2>Registrar Caja</h2>

<div id="alertaError" class="alert alert-danger d-none"></div>

<div class="mb-3">
    <label class="form-label">Nombre</label>
    <input type="text" class="form-control" id="Nombre" />
</div>
<div class="mb-3">
    <label class="form-label">Descripción</label>
    <input type="text" class="form-control" id="Descripcion" />
</div>
<div class="mb-3">
    <label class="form-label">Teléfono SINPE</label>
    <input type="text" class="form-control" id="TelefonoSINPE" />
</div>
<div class="mb-3">
    <a id="btnCancelar" href="#" class="btn btn-secondary">Cancelar</a>
    <button class="btn btn-primary" id="btnGuardar">Guardar</button>
</div>

@section Scripts {
    <script>
        const API = "https://localhost:7004";
        const idComercio = parseInt(window.location.pathname.split("/").pop());

        $("#btnCancelar").attr("href", `/Cajas/Index/${idComercio}`);

        $("#btnGuardar").click(function() {
            const caja = {
                idComercio: idComercio,
                nombre: $("#Nombre").val(),
                descripcion: $("#Descripcion").val(),
                telefonoSINPE: $("#TelefonoSINPE").val()
            };

            $.ajax({
                url: `${API}/api/Cajas`,
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(caja),
                success: function() {
                    window.location.href = `/Cajas/Index/${idComercio}`;
                },
                error: function(xhr) {
                    const msg = xhr.responseJSON?.mensaje ?? "Error al registrar la caja.";
                    $("#alertaError").text(msg).removeClass("d-none");
                }
            });
        });
    </script>
}