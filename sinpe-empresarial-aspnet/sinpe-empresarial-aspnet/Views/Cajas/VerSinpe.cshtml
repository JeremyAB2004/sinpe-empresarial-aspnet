@{
    ViewBag.Title = "SINPE recibidos";
}

<h2>SINPE recibidos — <span id="lblTelefono"></span></h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Teléfono origen</th>
            <th>Nombre origen</th>
            <th>Teléfono destinatario</th>
            <th>Nombre destinatario</th>
            <th>Monto</th>
            <th>Descripción</th>
            <th>Fecha</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody id="bodySinpe"></tbody>
</table>

<a id="btnVolver" href="#" class="btn btn-secondary">Volver a Cajas</a>

@section Scripts {
    <script>
        const API = "https://localhost:7004";

        // URL: /Cajas/VerSinpe/5?idComercio=2
        const partes = window.location.pathname.split("/");
        const idCaja = parseInt(partes[partes.length - 1]);
        const params = new URLSearchParams(window.location.search);
        const idComercio = params.get("idComercio");

        $("#btnVolver").attr("href", `/Cajas/Index/${idComercio}`);

        // Primero obtener el teléfono SINPE de la caja
        $.ajax({
            url: `${API}/api/Cajas/detalle/${idCaja}`,
            method: "GET",
            success: function(caja) {
                const telefono = caja.telefonoSINPE;
                $("#lblTelefono").text(telefono);

                // Luego cargar los SINPE de ese teléfono
                $.ajax({
                    url: `${API}/api/Sinpe/${telefono}`,
                    method: "GET",
                    success: function(data) {
                        let filas = "";
                        if (data.length === 0) {
                            filas = `<tr><td colspan="8" class="text-center text-muted">Sin registros</td></tr>`;
                        } else {
                            data.forEach(s => {
                                const fecha = new Date(s.fechaDeRegistro).toLocaleDateString("es-CR");
                                filas += `<tr>
                                        <td>${s.telefonoOrigen}</td>
                                        <td>${s.nombreOrigen}</td>
                                        <td>${s.telefonoDestinatario}</td>
                                        <td>${s.nombreDestinatario}</td>
                                        <td>₡${s.monto.toLocaleString("es-CR")}</td>
                                        <td>${s.descripcion ?? "-"}</td>
                                        <td>${fecha}</td>
                                        <td>${s.estado ? "Sincronizado" : "No sincronizado"}</td>
                                    </tr>`;
                            });
                        }
                        $("#bodySinpe").html(filas);
                    },
                    error: function() {
                        $("#bodySinpe").html(`<tr><td colspan="8" class="text-danger">Error al cargar los SINPE.</td></tr>`);
                    }
                });
            }
        });
    </script>
}