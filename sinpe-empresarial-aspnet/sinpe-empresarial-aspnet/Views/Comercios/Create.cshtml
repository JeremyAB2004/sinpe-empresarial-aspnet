@{
    ViewBag.Title = "Registrar Comercio";
}

<h2>Registrar Comercio</h2>

<div id="alertaExito" class="alert alert-success d-none"></div>
<div id="alertaError" class="alert alert-danger d-none"></div>

<div id="formulario">
    <div class="mb-3">
        <label class="form-label">Identificación</label>
        <input type="text" class="form-control" id="Identificacion" placeholder="Ingrese la identificación" />
    </div>
    <div class="mb-3">
        <label class="form-label">Tipo de Identificación</label>
        <select class="form-control" id="TipoIdentificacion">
            <option value="">-- Seleccione --</option>
            <option value="1">Física</option>
            <option value="2">Jurídica</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input type="text" class="form-control" id="Nombre" placeholder="Ingrese el nombre" />
    </div>
    <div class="mb-3">
        <label class="form-label">Tipo de Comercio</label>
        <select class="form-control" id="TipoDeComercio">
            <option value="">-- Seleccione --</option>
            <option value="1">Restaurante</option>
            <option value="2">Supermercado</option>
            <option value="3">Ferretería</option>
            <option value="4">Otro</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Teléfono</label>
        <input type="text" class="form-control" id="Telefono" placeholder="Ingrese el teléfono" />
    </div>
    <div class="mb-3">
        <label class="form-label">Correo Electrónico</label>
        <input type="text" class="form-control" id="CorreoElectronico" placeholder="Ingrese el correo" />
    </div>
    <div class="mb-3">
        <label class="form-label">Dirección</label>
        <input type="text" class="form-control" id="Direccion" placeholder="Ingrese la dirección" />
    </div>
    <div class="mb-3">
        <a href="/Comercios/Index" class="btn btn-danger">Cancelar</a>
        <button class="btn btn-primary" id="btnRegistrar">Registrar</button>
    </div>
</div>

@section Scripts {
    <script>
        const API = "https://localhost:7004";

        $("#btnRegistrar").click(function() {
            const comercio = {
                identificacion: $("#Identificacion").val(),
                tipoIdentificacion: parseInt($("#TipoIdentificacion").val()),
                nombre: $("#Nombre").val(),
                tipoDeComercio: parseInt($("#TipoDeComercio").val()),
                telefono: $("#Telefono").val(),
                correoElectronico: $("#CorreoElectronico").val(),
                direccion: $("#Direccion").val()
            };

            $.ajax({
                url: `${API}/api/Comercios`,
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(comercio),
                success: function() {
                    $("#alertaExito").text("Comercio registrado correctamente.").removeClass("d-none");
                    $("#alertaError").addClass("d-none");
                    $("#formulario input, #formulario select").val("");
                },
                error: function(xhr) {
                    const msg = xhr.responseJSON?.mensaje ?? "Error al registrar el comercio.";
                    $("#alertaError").text(msg).removeClass("d-none");
                    $("#alertaExito").addClass("d-none");
                }
            });
        });
    </script>
}