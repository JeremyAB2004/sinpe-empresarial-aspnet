@{
    ViewBag.Title = "Listado de Comercios";
}

<h2>Listado de Comercios</h2>

<a class="btn btn-primary" href="/Comercios/Create" role="button">Registrar Comercio</a>

<table class="table table-striped mt-3" id="tblComercios">
    <thead>
        <tr>
            <th>Identificación</th>
            <th>Tipo Identificación</th>
            <th>Nombre</th>
            <th>Tipo Comercio</th>
            <th>Teléfono</th>
            <th>Correo Electrónico</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody id="bodyComercios"></tbody>
</table>

@section Scripts {
    <script>
        const API = "https://localhost:7004";

        const tipoIdLabel = { 1: "Física", 2: "Jurídica" };
        const tipoComLabel = { 1: "Restaurante", 2: "Supermercado", 3: "Ferretería", 4: "Otro" };

        function cargarComercios() {
            $.ajax({
                url: `${API}/api/Comercios`,
                method: "GET",
                success: function(data) {
                    let filas = "";
                    data.forEach(c => {
                        filas += `<tr>
                                <td>${c.identificacion}</td>
                                <td>${tipoIdLabel[c.tipoIdentificacion] ?? c.tipoIdentificacion}</td>
                                <td>${c.nombre}</td>
                                <td>${tipoComLabel[c.tipoDeComercio] ?? c.tipoDeComercio}</td>
                                <td>${c.telefono}</td>
                                <td>${c.correoElectronico}</td>
                                <td>${c.estado ? "Activo" : "Inactivo"}</td>
                                <td>
                                    <a class="btn btn-warning btn-sm" href="/Comercios/Edit/${c.idComercio}">Editar</a>
                                    <a class="btn btn-success btn-sm" href="/Comercios/Details/${c.idComercio}">Detalles</a>
                                    <a class="btn btn-info btn-sm" href="/Cajas/Index/${c.idComercio}">Ver Cajas</a>
                                </td>
                            </tr>`;
                    });
                    $("#bodyComercios").html(filas);
                },
                error: function() {
                    alert("Error al cargar los comercios.");
                }
            });
        }

        $(document).ready(function() {
            cargarComercios();
        });
    </script>
}