@{
    ViewBag.Title = "Detalles Comercio";
}

<h2>Detalles del Comercio</h2>

<div class="mb-3">
    <label class="form-label">Identificación</label>
    <input type="text" class="form-control" id="Identificacion" disabled />
</div>
<div class="mb-3">
    <label class="form-label">Tipo de Identificación</label>
    <input type="text" class="form-control" id="TipoIdentificacion" disabled />
</div>
<div class="mb-3">
    <label class="form-label">Nombre</label>
    <input type="text" class="form-control" id="Nombre" disabled />
</div>
<div class="mb-3">
    <label class="form-label">Tipo de Comercio</label>
    <input type="text" class="form-control" id="TipoDeComercio" disabled />
</div>
<div class="mb-3">
    <label class="form-label">Teléfono</label>
    <input type="text" class="form-control" id="Telefono" disabled />
</div>
<div class="mb-3">
    <label class="form-label">Correo Electrónico</label>
    <input type="text" class="form-control" id="CorreoElectronico" disabled />
</div>
<div class="mb-3">
    <label class="form-label">Dirección</label>
    <input type="text" class="form-control" id="Direccion" disabled />
</div>
<div class="mb-3">
    <label class="form-label">Fecha de Registro</label>
    <input type="text" class="form-control" id="FechaDeRegistro" disabled />
</div>
<div class="mb-3">
    <label class="form-label">Fecha de Modificación</label>
    <input type="text" class="form-control" id="FechaDeModificacion" disabled />
</div>
<div class="mb-3">
    <label class="form-label">Estado</label>
    <input type="text" class="form-control" id="Estado" disabled />
</div>
<div class="mb-3">
    <a id="btnEditar" href="#" class="btn btn-warning">Editar</a>
    <a href="/Comercios/Index" class="btn btn-danger">Volver</a>
</div>

@section Scripts {
    <script>
        const API = "https://localhost:7004";

        const tipoIdLabel = { 1: "Física", 2: "Jurídica" };
        const tipoComLabel = { 1: "Restaurante", 2: "Supermercado", 3: "Ferretería", 4: "Otro" };

        const idComercio = parseInt(window.location.pathname.split("/").pop());

        function formatFecha(f) {
            if (!f) return "N/A";
            return new Date(f).toLocaleDateString("es-CR", {
                day: "2-digit", month: "2-digit", year: "numeric",
                hour: "2-digit", minute: "2-digit"
            });
        }

        $.ajax({
            url: `${API}/api/Comercios/${idComercio}`,
            method: "GET",
            success: function(c) {
                $("#Identificacion").val(c.identificacion);
                $("#TipoIdentificacion").val(tipoIdLabel[c.tipoIdentificacion] ?? c.tipoIdentificacion);
                $("#Nombre").val(c.nombre);
                $("#TipoDeComercio").val(tipoComLabel[c.tipoDeComercio] ?? c.tipoDeComercio);
                $("#Telefono").val(c.telefono);
                $("#CorreoElectronico").val(c.correoElectronico);
                $("#Direccion").val(c.direccion);
                $("#FechaDeRegistro").val(formatFecha(c.fechaDeRegistro));
                $("#FechaDeModificacion").val(formatFecha(c.fechaDeModificacion));
                $("#Estado").val(c.estado ? "Activo" : "Inactivo");
                $("#btnEditar").attr("href", `/Comercios/Edit/${c.idComercio}`);
            }
        });
    </script>
}