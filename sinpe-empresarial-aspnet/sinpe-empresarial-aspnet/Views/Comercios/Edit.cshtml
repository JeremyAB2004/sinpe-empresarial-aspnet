@{
    ViewBag.Title = "Editar Comercio";
}

<h2>Editar Comercio</h2>

<div id="alertaError" class="alert alert-danger d-none"></div>

<div class="mb-3">
    <label class="form-label">Nombre</label>
    <input type="text" class="form-control" id="Nombre" />
</div>
<div class="mb-3">
    <label class="form-label">Tipo de Comercio</label>
    <select class="form-control" id="TipoDeComercio">
        <option value="1">Restaurante</option>
        <option value="2">Supermercado</option>
        <option value="3">Ferretería</option>
        <option value="4">Otro</option>
    </select>
</div>
<div class="mb-3">
    <label class="form-label">Teléfono</label>
    <input type="text" class="form-control" id="Telefono" />
</div>
<div class="mb-3">
    <label class="form-label">Correo Electrónico</label>
    <input type="text" class="form-control" id="CorreoElectronico" />
</div>
<div class="mb-3">
    <label class="form-label">Dirección</label>
    <input type="text" class="form-control" id="Direccion" />
</div>
<div class="mb-3">
    <label class="form-label">Estado</label>
    <select class="form-control" id="Estado">
        <option value="true">Activo</option>
        <option value="false">Inactivo</option>
    </select>
</div>
<div class="mb-3">
    <a href="/Comercios/Index" class="btn btn-danger">Cancelar</a>
    <button class="btn btn-primary" id="btnGuardar">Guardar</button>
</div>

@section Scripts {
    <script>
        const API = "https://localhost:7004";

        // Leer el ID de la URL: /Comercios/Edit/5
        const idComercio = parseInt(window.location.pathname.split("/").pop());

        // Cargar datos actuales
        $.ajax({
            url: `${API}/api/Comercios/${idComercio}`,
            method: "GET",
            success: function(c) {
                $("#Nombre").val(c.nombre);
                $("#TipoDeComercio").val(c.tipoDeComercio);
                $("#Telefono").val(c.telefono);
                $("#CorreoElectronico").val(c.correoElectronico);
                $("#Direccion").val(c.direccion);
                $("#Estado").val(c.estado.toString());
            }
        });

        $("#btnGuardar").click(function() {
            const comercio = {
                idComercio: idComercio,
                nombre: $("#Nombre").val(),
                tipoDeComercio: parseInt($("#TipoDeComercio").val()),
                telefono: $("#Telefono").val(),
                correoElectronico: $("#CorreoElectronico").val(),
                direccion: $("#Direccion").val(),
                estado: $("#Estado").val() === "true"
            };

            $.ajax({
                url: `${API}/api/Comercios`,
                method: "PUT",
                contentType: "application/json",
                data: JSON.stringify(comercio),
                success: function() {
                    window.location.href = "/Comercios/Index";
                },
                error: function(xhr) {
                    const msg = xhr.responseJSON?.mensaje ?? "Error al actualizar.";
                    $("#alertaError").text(msg).removeClass("d-none");
                }
            });
        });
    </script>
}